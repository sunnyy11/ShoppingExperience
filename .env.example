BASE_URL=https://automationexercise.com
AUTOMATION_EXERCISE_TEST_EMAIL_1=
AUTOMATION_EXERCISE_TEST_PASSWORD_1=
AUTOMATION_EXERCISE_TEST_EMAIL_2=
AUTOMATION_EXERCISE_TEST_PASSWORD_2=
AUTOMATION_EXERCISE_TEST_EMAIL_3=
AUTOMATION_EXERCISE_TEST_PASSWORD_3=
AUTOMATION_EXERCISE_TEST_EMAIL_4=
AUTOMATION_EXERCISE_TEST_PASSWORD_4=
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
# Enables the send, reply, and forward email tests
MAILOSAUR_VERIFIED_EMAIL=

# Winston logging
# Level for the log files: error | warn | info | debug
LOG_LEVEL=info
# Level for the console output; use "off" to silence the console
LOG_CONSOLE_LEVEL=info
# Directory that receives combined.log and error.log
LOG_DIR=logs
# Set to false to disable the log files
LOG_TO_FILE=true

# Local worker count. Every worker drives a full browser, so keep it at or
# below the number of physical cores.
PW_WORKERS=2